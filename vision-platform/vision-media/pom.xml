<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yujian.vision</groupId>
        <artifactId>vision-platform</artifactId>
        <version>1.0.1</version>
    </parent>
    <artifactId>vision-media</artifactId>
    <name>vision-media</name>
    <description>ZLMediaKit API 客户端、Hook 接收分发、媒体会话/SSRC/端口管理</description>

    <dependencies>
        <dependency>
            <groupId>com.yujian.vision</groupId>
            <artifactId>vision-common</artifactId>
        </dependency>
        <!-- ZLM API 调用（连接池化，与参考工程一致） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 组件装配（@Component 由宿主应用组件扫描加载，与 vision-sip 一致） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 测试（ZlmCodecsTest）；干净构建此前缺此依赖会 testCompile 失败 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
