# ============================================================================
# 平台环境变量模板（compose env_file 注入 vision-platform 容器）: cp vision.env.example vision.env 填真值
# 与 systemd 版（deploy/vision.env.example）差异: MySQL/Redis host 由 compose 写死为服务名
# （无需也不必在本文件配置）; LOG_DIR/快照目录=容器路径; 多 VISION_SIP_PUBLIC_IP（容器化必配）
# 密钥生成方法与 AES 轮换流程见 deploy/vision.env.example 与 deploy/README.md §5.1
# ============================================================================
SPRING_PROFILES_ACTIVE=prod
# REST 监听端口（与 docker-compose.yml 的 API_PORT 映射目标一致; 缺省回落 base yaml 的 8080 会致映射错位）
SERVER_PORT=8082
# 容器内 REST 监听 0.0.0.0（端口映射由 compose 管）, 不要设 server.address/SERVER_ADDRESS

# --- 数据库（账号密码须与 .env 的 MYSQL_USER/MYSQL_PASSWORD 一致） ---
MYSQL_USERNAME=vision
MYSQL_PASSWORD=

# --- Redis（密码须与 .env 的 REDIS_PASSWORD 一致; host 由 compose 写死=redis） ---
SPRING_DATA_REDIS_PASSWORD=
REDIS_DB=0

# --- 密钥（ProdSecretGuard 强校验: 弱值/缺失直接拒启） ---
# JWT 签名密钥 >=32 字符（换值 = 全量会话失效）
VISION_JWT_SECRET=<生成: openssl rand -hex 32>
# 设备密码/节点 secret/RTSP 源地址的 AES 密钥 >=32 字符
VISION_AES_KEY=<生成: openssl rand -hex 32>

# --- 告警回调令牌（ProdSecretGuard 必填 >=16 字符; 监控栈 Alertmanager 回调用同一值,
# 不部署监控栈也必须配——弱默认值 prod 拒启; 生成: openssl rand -hex 16） ---
VISION_ALERTWEBHOOKTOKEN=<生成: openssl rand -hex 16>

# --- 播放地址外部 base（容器化必配, 属性 vision.play.public-base） ---
# 对外播放 URL（flv/hls/rtc）的 base = 终端可达的 ZLM 播放地址（http://<宿主IP>:ZLM_HTTP_PORT）。
# 缺省按节点 publicIp:httpPort 拼——容器化下 httpPort=80 是容器内口（平台调 ZLM API 用）,
# 对外不可达, 播放会静默黑屏, 故必须显式覆盖
VISION_PLAY_PUBLIC_BASE=http://<宿主IP>:18081

# --- SIP 宣告地址（容器化必配, 单机裸跑无需） ---
# =宿主对外 IP（设备的回包/推流目标）。缺省时 Via/Contact 兜底容器内网 IP（172.30.x.x）,
# 规范实现的设备按 Via 回包即断。SDP 媒体地址不走此项（=gb_media_server.public_ip, 平台页面配置）
VISION_SIP_PUBLIC_IP=<宿主对外 IP>

# --- 日志（容器路径; 宿主 ./logs 挂载, journalctl 换成 docker logs vision-platform） ---
LOG_DIR=/app/logs

# --- 服务端抓图（容器路径; 宿主 ./data/snapshot 挂载, 双实例同目录问题不存在=单机单实例） ---
VISION_SNAPSHOT_DIR=/app/data/snapshot

# --- 可信代理（客户端 IP 解析权威, 登录防爆破/限流/审计日志全依赖它） ---
# compose 固定网段 CIDR 整段可信（免疫 webui 容器 IP 漂移; 网段定义在 docker-compose.yml networks 段,
# 改网段两处同步）。终端用户 IP 经 webui 反代 XFF 透传进来
VISION_SECURITY_TRUSTEDPROXIES_0=172.30.0.0/24

# --- 开放接口 OpenAPI（见 docs/16-OpenAPI对接手册.md; 不启用则两行都不要——功能整体不装配, 零行为） ---
# 总开关: 缺省 false。true 时签名过滤器/8 个开放端点/管理面才装配
# VISION_OPENAPI_ENABLED=true
# app_secret 的 SM4 加密主密钥: 仅 ENABLED=true 时必填, 缺失/弱值 prod 拒绝启动;
# 与上面的 VISION_AES_KEY 相互独立; 设定后不可更换(换钥=存量应用 secret 全部失效需逐个重置)
# 生成: openssl rand -hex 32
# VISION_SM4_KEY=<生成: openssl rand -hex 32>
