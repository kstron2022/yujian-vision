# ============================================================================
# compose 编排变量模板: cp .env.example .env 后填真值（chmod 600）
# 平台业务环境变量另有一份 vision.env（模板 vision.env.example）, 两份都要填
# 表结构由平台启动时 Flyway 自动创建（含种子菜单/角色/admin 初始账号）, 无需手工建表
# ============================================================================
# --- MySQL ---
MYSQL_ROOT_PASSWORD=<生成: openssl rand -hex 16>
MYSQL_DATABASE=vision_platform
MYSQL_USER=vision
MYSQL_PASSWORD=<生成: openssl rand -hex 16>
# 宿主机运维直连端口（compose 只绑 127.0.0.1, 不对网段开放）
MYSQL_PORT=3306
# --- Redis ---
REDIS_PASSWORD=<生成: openssl rand -hex 16>
REDIS_PORT=6379
# --- ZLM ---
# secret 真值三处一致: ①.env 无此变量（不走插值）②zlm/config.ini 的 CHANGE_ME_FILL_AT_DEPLOY 全部替换
# ③平台「流媒体节点」页新增节点时填同一值（= gb_media_server.sign_secret）
# 生成: openssl rand -hex 16
ZLM_HTTP_PORT=8081
ZLM_RTSP_PORT=554
ZLM_RTMP_PORT=1935
# RTP 收流段（=最大并发收流路数; config.ini 的 rtp_proxy.port_range 与此段一致——config.ini 是占位
# 30000-30500, 改了 .env 端口段必须同步改 config.ini）
ZLM_RTP_START=30000
ZLM_RTP_END=30500
# --- 平台 ---
API_PORT=8082
SIP_PORT=5060
# --- 前端 ---
WEBUI_PORT=8090
