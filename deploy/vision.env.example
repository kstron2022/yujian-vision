# ============================================================================
# vision-platform 生产环境变量模板（systemd EnvironmentFile）
# 用法：复制到目标机 /opt/vision/vision.env，填入真实密钥，chmod 600 root:root
#       systemctl restart vision-platform 生效
# 规则：本文件是脱敏模板【不入库真实密钥】（deploy/README.md §3），
#       真值只存在于目标机 /opt/vision/vision.env + 本地部署口令速查（会话记忆）
# ============================================================================

# --- 基础 ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082

# --- 数据库（base yaml 缺省 root/root 不可用，必须注入） ---
MYSQL_USERNAME=vision
MYSQL_PASSWORD=<生成：openssl rand -hex 16 之类，并同步在 MySQL 建账号授权>

# --- Redis ---
# 无密码实例：不要设 SPRING_DATA_REDIS_PASSWORD（空串会触发空 AUTH 被拒，deploy README §4）
# 有密码实例：SPRING_DATA_REDIS_PASSWORD=<密码>
REDIS_DB=1
# 注意 REDIS_DB 选一个不被业务方占用的逻辑库；示例环境用 db1

# --- 密钥（ProdSecretGuard 强校验：弱默认值/缺失直接拒启） ---
# JWT 签名密钥，>=32 字符；换值 = 全量会话失效
VISION_JWT_SECRET=<生成：openssl rand -hex 32>
# 设备密码/节点 secret 的 AES 密钥（>=32 字符）
# ⚠️ 复用含存量密文的库必须先跑密钥轮换工具迁移，否则解密失败
VISION_AES_KEY=<生成：openssl rand -hex 32>
# 旧密钥（可选，仅密钥轮换窗口临时设置，平时不配；步骤见 deploy/README §5.1）：
# 轮换时把换下的旧密钥填到这里 + 换新 VISION_AES_KEY → restart → 日志核对
# "轮换 X 条(失败跳过 0)" → 删除本行再 restart。不设置 = 轮换功能不启用
# VISION_AES_OLD_KEY=<换下的旧密钥>

# --- 告警回调令牌（ProdSecretGuard 必填 >=16 字符; 监控栈启用时与 alertmanager.yml 同值, 详见 deploy/README §7） ---
VISION_ALERTWEBHOOKTOKEN=<生成: openssl rand -hex 16>

# --- 日志 ---
LOG_DIR=/opt/vision/logs

# --- 服务端抓图（M3-B7 阶段2） ---
# 截图落盘目录（base yaml 默认 ./data/snapshot 不适合 prod; 先 mkdir -p 再指向这里）
VISION_SNAPSHOT_DIR=/opt/vision/data/snapshot
# 空闲通道抓图开关（默认关; 仅真机验证"抓完即停"时临时设 true 重启, 验完改回并再重启）
# VISION_SNAPSHOT_IDLE_ENABLED=true

# ============================================================================
# 可信代理列表（客户端 IP 解析；配错=登录日志/限流退化为全用户共享桶）
# 作用：仅当"直接连到平台的地址"命中本列表时才采信 X-Forwarded-For，
#       且按追加式语义取"从右向左第一个非可信地址"；否则一律用直连地址。
#       这是登录防爆破/接口限流(1009)/登录日志 client_ip 的唯一 IP 权威。
# 语法：_0/_1/_2... 依次编号；值为精确 IP 或 IPv4 CIDR
# ⚠️ 默认留空 = 完全不信任 XFF（安全默认）。经 Nginx 反代部署【必须】配置：
#    不配 → 所有反代用户共享一个限流桶（login 60/min 互相挤兑），
#           且登录日志 client_ip 全是同一个容器 IP，无法审计到人
# ⚠️ 值是【反代组件到达平台的源地址】：
#    实测 = webui(nginx) 容器自身 IP（例 172.17.0.7） —— 容器→宿主机 IP 的
#    hairpin 流量不经 MASQUERADE，平台看到的是容器 IP 而非 docker 网关 .0.1！
#    查法：docker inspect vision-webui --format '{{range $k,$v := .NetworkSettings.Networks}}{{$v.IPAddress}}{{end}}'
#    容器重建可能换 IP（症状：登录日志 client_ip 全变成同一个 172.17.0.x），
#    变了重新查一遍改这里。用固定网络/-host 模式可避免（M2 优化项）
# ⚠️ 禁止开启 server.forward-headers-strategy=native（application-prod.yaml 已注释说明）：
#    Tomcat RemoteIpValve 默认信任全部私网段，会在本机制之前改写 remoteAddr/XFF，
#    VPN/内网真实来源被当代理跳过、伪造段反被采信
# ============================================================================
VISION_SECURITY_TRUSTEDPROXIES_0=<反代组件源 IP，如 172.17.0.7>
VISION_SECURITY_TRUSTEDPROXIES_1=127.0.0.1

# --- 可选：SIP 国标身份（不设则用 application.yaml 默认值；生产必须按分配编码改） ---
# 国标编码/域/realm 当前在打包 yaml 内（vision.gb.*），换环境时若编码不同需
# 覆盖 VISION_GB_SERVERID / VISION_GB_DOMAIN / VISION_GB_REALM 并同步改数据库 gb_platform

# --- 可选：ONVIF 同网段探测（多网卡必须配本项）---
# WS-Discovery 组播出接口 IP。多网卡环境【必须】配为本机业务网口 IP：
#    不配 = 内核按路由表选口，有 docker/dummy 等虚拟口的机器会发错接口
#    → 组播出不去 → 探测永远 0 结果且无报错（现象难排查）
# 示例：VISION_ONVIF_DISCOVERY_INTERFACE_IP=10.0.0.10
# VISION_ONVIF_DISCOVERY_INTERFACE_IP=
# 收响应窗口毫秒（默认 4000, 一般无需调整）
# VISION_ONVIF_DISCOVERY_TIMEOUT_MS=4000
