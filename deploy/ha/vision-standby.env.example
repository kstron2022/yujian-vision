# 备实例 B 环境变量（复制为 /opt/vision/vision-standby.env）。
# 除下列差异项外, 与 /opt/vision/vision.env 全量一致(DB/Redis/AES/JWT/GB 域等)。
# 差异项:
SERVER_ADDRESS=10.0.0.243
VISION_HA_ENABLED=true
VISION_HA_ROLE=standby
VISION_SIP_AUTOSTART=false
VISION_HA_PEER_BASE_URL=http://10.0.0.242:8082
# 与 A 的 vision.env 同值(强随机, >=16 字符):
VISION_HA_TOKEN=CHANGE-ME-strong-random-token
# 独立日志目录(B)（logback ${log.dir}, 同 A 的 LOG_DIR）:
LOG_DIR=/opt/vision/logs-standby
